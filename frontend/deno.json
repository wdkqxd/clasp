{
  "private": true,
  "type": "module",
  "nodeModulesDir": "auto",

  "imports": {
    "@lucide/svelte": "npm:@lucide/svelte@^1.49.0",
    "@sveltejs/adapter-auto": "npm:@sveltejs/adapter-auto@^7.0.1",
    "@sveltejs/adapter-static": "npm:@sveltejs/adapter-static@^3.0.10",
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.63.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.1.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "devalue": "npm:devalue@^5.9.4",
    "marked": "npm:marked@^16.4.2",
    "mathjs": "npm:mathjs@^14.8.0",
    "numis": "npm:numis@^1.1.2",
    "svelte": "npm:svelte@^5.56.1",
    "svelte-check": "npm:svelte-check@^4.6.0",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "npm:vite@^8.0.16"
  },

  "tasks": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  }
}
