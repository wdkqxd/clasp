{
  "tasks": {
    "dev": "deno task dev:go & deno task dev:frontend",
    "dev:go": "go run .",
    "dev:frontend": "cd frontend && deno task dev",
    "build": "cd frontend && deno task build",
    "start": "go run .",
    "check": "cd frontend && deno task check",
    "lint": "cd frontend && deno task lint",
    "lint:fix": "cd frontend && deno task lint:fix"
  }
}
