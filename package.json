{
  "name": "clasp",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm run dev:go & pnpm run dev:frontend",
    "dev:go": "go run ./backend/cmd/clasp",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "start": "go run ./backend/cmd/clasp",
    "check": "pnpm --filter frontend check",
    "lint": "pnpm --filter frontend lint",
    "lint:fix": "pnpm --filter frontend lint:fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "backend/**/*.go": "gofmt -w",
    "frontend/**/*.{js,ts,svelte,css}": "pnpm --filter frontend exec biome check --write"
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"]
  }
}
