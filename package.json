{
	"name": "metasearch",
	"version": "0.1.0",
	"scripts": {
		"dev": "concurrently --delay 2s \"bun run dev:go\" \"bun run dev:frontend\"",
		"dev:go": "go run .",
		"dev:frontend": "cd frontend && bun run dev",
		"build": "cd frontend && bun run build",
		"start": "go run .",
		"check": "cd frontend && bun run check"
	},
	"devDependencies": {
		"concurrently": "^9.1.2"
	}
}
